#!/usr/bin/env bash
# Wrapper executável portátil para invocar ctx sem instalação.
# Usa sempre o Python do .venv do workspace (criado sob demanda por scripts/venv-python); nunca o python global.
set -euo pipefail
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export PYTHONPATH="${DIR}/src:${PYTHONPATH:-}"
exec "${DIR}/scripts/venv-python" -m ctx.cli "$@"
